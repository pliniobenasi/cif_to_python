//Exercise 3 - Module 1.4
automaton ShipCounter:
    event ship_enters, ship_leaves;
    disc int count = 0;
    marked count = 0;

    location Counter:
        initial;
        marked;
        edge ship_enters when count < 5 do count := count+1 goto Counter;
        edge ship_leaves when count > 0 do count := count-1 goto Counter;
end

