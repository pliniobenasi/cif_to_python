/**
 NODES
*/
const real N0=5;
const real Nm =  0.66;
const real T0 = 5;
const real T1 = 14;
const real T2 = 28;
const real T3 = 42;

automaton def Nodes (alg real T_mean):
    uncontrollable day;
    disc real K0 = 0.55/(T1-T0);
    disc real C0 = -K0*T0;
    disc real K1 = 0.45/(T2-T1);
    disc real C1 = 0.55-K1*T1;
    disc real K2 = -1/(T3-T2);
    disc real C2 = -K2*T3;

    cont c=0;
    disc real N= N0;
    disc real Nd = N; //previous value - simplify computation

    alg real dn = if T_mean <= T0 or T_mean >= T3 : 0
                  elif T_mean> T0 and T_mean < T1: Nm*(C0+K0*T_mean)
                  elif T_mean>= T1 and T_mean<= T2: Nm*(C1+K1*T_mean)
                  elif T_mean> T2 and T_mean< T3: Nm*(C2+K2*T_mean)
                  else 0
                  end;

    location N_0:initial; marked;
        equation c' = 1;
        //invariant c<=24*H;
        edge day when c>=24*H do N:=N+dn, Nd:=N, c:=0;
end


/**
 LAI
*/
const real L0=0.015;
const real a=0.001;
const real b=250000;
const real LAIMAX=1.435;
const real d=3.6;

automaton def LAI(Nodes nodes):
    uncontrollable day;

    cont c=0;
    disc real lai = L0; // Number of plant's nodes

    alg real DN = nodes.N - nodes.Nd;
    alg real dh = (b*d*(LAIMAX-a)*pow(nodes.N,(d-1)))/(pow(b+pow(nodes.N,d),2));

    location L_0:initial; marked;
        equation c'=1;
        //invariant c<=24*H;
        edge day when c>=24*H do lai:=lai+dh*DN, c:=0;
end


const real WM2_TO_PPFD_CONVERSION=2.1;
const real QE =  0.0645;
const real Q10= 1.4;
const real D= 2.593;
const real K= 0.58;
const real TAU= 0.0693;
const real m= 0.1;

const real Vmax = 2;
const real E = 0.06;
const real theta = 0.22;
const real NFF = 13;
const real KFF = 16;
const real krm = 0.005;
const real cfngt = 7;
const real dfmax = 0.062;
const real p1p = 1;
const real alphaF = 0.47;
const real rho = 1;
const real Tcrit = 30;
const real co2 = 400;
const real bio0 = 0;

automaton  def Biomass(LAI lai; Nodes nodes; alg real T_mean; alg real T_d_mean;alg real Rad):
    uncontrollable hour;
    uncontrollable day;
    uncontrollable update;

    alg real PPFD = Rad * WM2_TO_PPFD_CONVERSION;
    alg real deltapg = ((D*TAU*co2*pgr)/K) * ln(((1-m)*TAU*co2+QE*K*PPFD)/( (1-m)*TAU*co2+QE*K*PPFD*exp(-K* lai.lai)));
    alg real deltarm = (pow(Q10,(T_in*0.1-2.0))*krm*w);
    alg real pgr = if  0<=T_in and T_in < 9: 0.074*T_in
                   elif (9<=T_in and T_in<12): 0.11*T_in-0.32
                   elif (12 <=T_in and T_in<= 28): 1
                   elif (28 < T_in and T_in <35): 5-T_in/7
                   else  0
                   end;
    alg real grnet = if nodes.N < 1: max(0,E*(pg+deltapg - rm-deltarm))
                    elif nodes.N >=1 and nodes.N< 12: max(0,E*(pg+deltapg - rm-deltarm)*(1-0.205+0.0045*nodes.N))
                    elif nodes.N >=12 and nodes.N< 21: max(0,E*(pg+deltapg - rm-deltarm)*(1-0.217+0.006*nodes.N))
                    elif nodes.N >=21 and nodes.N<= 30: max(0,E*(pg+deltapg - rm-deltarm)*(1-0.17+0.003*nodes.N))
                    else max(0,E*(pg - rm)*(1-0.07))
                    end;
    /*alg real ff = if T_mean > 8 and T_mean <= 28: 0.0017 * T_mean - 0.0147
                    elif T_mean > 28 and T_mean <35:  0.032
                    elif T_mean < 50: 0.106667 - 0.00213333*T_mean
                    else 0
                    end;*/
    alg real ff = max(0,min(1,0.0625*(T_mean-cfngt)));
    alg real dwf = if nodes.N < NFF :0
                    elif T_d_mean >= Tcrit: max(0,grnet*alphaF*ff*(1-exp(-theta*(nodes.N-NFF))))*max(0,1-0.154*(T_d_mean-Tcrit))
                        else max(0,grnet*alphaF*ff*(1-exp(-theta*(nodes.N-NFF))))
                    end;
    alg real p1= if lai.lai > LAIMAX: p1p
                    else 0
                    end;

    alg real dn = nodes.N - nodes.Nd;
    alg real dw = max(0,min(grnet-p1*rho*dn,dwf+(Vmax-p1)*rho*dn));
    alg real dwm = (wf-wm)*dfmax*max(0,min(1,0.0714*(T_mean-9)));

    cont c=0;
    disc int cd = 0;
    disc real pg=0;
    disc real rm=0;
    disc real w=bio0;
    disc real wf=0;
    disc real wm=0;

    location B0:initial; marked;
        equation c'=1;
        //invariant (c>0 and c<=H) or (c=0 and cd<=24 and nodes.N <=NFF);
        edge hour when c>=H and cd<24 do pg:=pg+deltapg, rm:=rm+deltarm, cd:=cd+1, c:=0;
        edge day when c>=H and cd=24 do w:=w+dw, pg:=0, rm:=0, cd:=0;
        edge update when c=0 and nodes.N >= NFF goto B1;

    location B1:marked;
        equation c'=1;
        //invariant (c>0 and c<=H) or (c=0 and cd<=24 and nodes.N <=NFF+KFF);
        edge hour when c>=H and cd<24 do pg:=pg+deltapg, rm:=rm+deltarm, cd:=cd+1, c:=0;
        edge day when c>=H and cd=24 do w:=w+dw,wf:=wf+dwf, pg:=0, rm:=0, cd:=0;
        edge update when c=0 and nodes.N >= NFF+KFF goto B2;

    location B2:marked;
        equation c'=1;
        //invariant (c>0 and c<=H) or (c=0 and cd<=24);
        edge hour when c>=H and cd<24 do pg:=pg+deltapg, rm:=rm+deltarm, cd:=cd+1, c:=0;
        edge day when c>=H and cd=24 do w:=w+dw,wf:=wf+dwf,wm:=wm+dwm, pg:=0, rm:=0, cd:=0;

end

/**
 Instantiation
*/

